# ==============================================================================
# Rota Express 3.0 — Configuração de Variáveis de Ambiente
# ==============================================================================
# Nunca insira segredos reais neste arquivo. No Google AI Studio, configure
# credenciais sensíveis exclusivamente pelo painel Settings > Secrets.

# URL pública da aplicação (injetada automaticamente no Cloud Run / AI Studio)
APP_URL=""

# ------------------------------------------------------------------------------
# Inteligência Artificial (exclusivo do backend)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Google Maps Platform
# ------------------------------------------------------------------------------
# Chave pública restrita por HTTP referrer e APIs permitidas (Maps JS / Routes JS)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_BROWSER_KEY=""

# Chave de servidor restrita por IP/serviço (Geocoding REST / Routes REST)
GOOGLE_MAPS_SERVER_KEY=""

# ID do projeto Google Cloud (necessário para Route Optimization API via ADC/OAuth)
GOOGLE_CLOUD_PROJECT_ID=""
FIREBASE_PROJECT_ID=""

# ------------------------------------------------------------------------------
# Motores de Roteirização e Geocodificação
# ------------------------------------------------------------------------------
# Provedores suportados: google | osrm | heuristic
ROUTING_PROVIDER="google"
GEOCODING_PROVIDER="google"

# Habilita chamadas reais à Google Route Optimization API (requer OAuth/ADC configurado)
ROUTE_OPTIMIZATION_ENABLED="false"

# Infraestrutura alternativa opcional (auto-hospedada ou serviço contratado)
OSRM_BASE_URL=""
ORTOOLS_SERVICE_URL=""

# ------------------------------------------------------------------------------
# Modo Demonstração e Governança de Custos
# ------------------------------------------------------------------------------
DEMO_MODE_ENABLED="true"
DAILY_API_LIMIT="500"
MONTHLY_API_BUDGET="150"
